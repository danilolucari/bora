{
  // Quatro configurações: debug e release, em Android e Web.
  //
  // DEBUG  — sobe contra os emuladores do Firebase (AD-004, emulator-first).
  //          Ligue o de auth antes:  firebase emulators:start --only auth
  //          O host muda sozinho por plataforma (EmulatorConfig.host):
  //          10.0.2.2 no emulador Android, localhost no web.
  //          O Firestore NÃO é usado no M1 (AD-016) — não precisa subir.
  //
  // RELEASE — `connectEmulators` sai cedo em release: nada de emulador.
  //          FirebaseEnvironment.resolve exige BORA_FIREBASE_PROJECT_ID com um
  //          id que não comece com "demo-", senão lança StateError no boot
  //          (FUND-16). Como o projeto real na nuvem ainda não existe, as duas
  //          configs de release PERGUNTAM o id ao iniciar, em vez de embutir um
  //          valor falso que alcançaria em silêncio um projeto inexistente.
  "version": "0.2.0",
  "inputs": [
    {
      "id": "firebaseProjectId",
      "type": "promptString",
      "description": "ID do projeto Firebase real (não pode começar com 'demo-')"
    }
  ],
  "configurations": [
    {
      "name": "bora - debug - android",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "debug"
    },
    {
      "name": "bora - release - android",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "android",
      "flutterMode": "release",
      "toolArgs": [
        "--dart-define=BORA_FIREBASE_PROJECT_ID=${input:firebaseProjectId}"
      ]
    },
    {
      "name": "bora - debug - web",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "flutterMode": "debug"
    },
    {
      "name": "bora - release - web",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "flutterMode": "release",
      "toolArgs": [
        "--dart-define=BORA_FIREBASE_PROJECT_ID=${input:firebaseProjectId}"
      ]
    }
  ]
}
